@@ -0,0 +1,92 @@
+package routemanager
+
+import (
+	"net/netip"
+	"os"
+	"strconv"
+	"sync"
+
+	log "github.com/sirupsen/logrus"
+
+	firewall "github.com/netbirdio/netbird/client/firewall/manager"
+)
+
+// envAllowRoutedSources enables accepting inbound traffic on the WireGuard
+// interface from the prefixes of client routes this peer has installed.
+//
+// Stock NetBird only admits peer IPs as sources, so hosts behind a routing
+// peer (for example VPN clients in a pool advertised as a network route) can
+// be reached from the mesh but cannot initiate connections to mesh peers.
+const envAllowRoutedSources = "NB_ALLOW_ROUTED_SOURCES"
+
+type routedSources struct {
+	mu    sync.Mutex
+	rules map[netip.Prefix]firewall.Rule
+}
+
+func allowRoutedSourcesEnabled() bool {
+	enabled, _ := strconv.ParseBool(os.Getenv(envAllowRoutedSources))
+	return enabled
+}
+
+// allowRoutedSource installs an inbound accept rule for the route prefix.
+// Failures are logged and never fail the route installation itself.
+func (m *DefaultManager) allowRoutedSource(prefix netip.Prefix) {
+	// never widen the input filter to everything for exit-node routes
+	if !allowRoutedSourcesEnabled() || m.firewall == nil || prefix.Bits() == 0 {
+		return
+	}
+
+	m.routedSources.mu.Lock()
+	defer m.routedSources.mu.Unlock()
+
+	if _, ok := m.routedSources.rules[prefix]; ok {
+		return
+	}
+
+	rule, err := m.firewall.AddFilterRule(
+		[]byte("routed-source-"+prefix.String()),
+		[]netip.Prefix{prefix.Masked()},
+		firewall.Network{},
+		firewall.ProtocolALL,
+		nil,
+		nil,
+		firewall.ActionAccept,
+	)
+	if err != nil {
+		log.Warnf("failed to allow inbound traffic from routed prefix %s: %v", prefix, err)
+		return
+	}
+	if err := m.firewall.Flush(); err != nil {
+		log.Warnf("failed to flush firewall after allowing routed prefix %s: %v", prefix, err)
+	}
+
+	if m.routedSources.rules == nil {
+		m.routedSources.rules = make(map[netip.Prefix]firewall.Rule)
+	}
+	m.routedSources.rules[prefix] = rule
+	log.Infof("allowed inbound traffic from routed prefix %s", prefix)
+}
+
+// removeRoutedSource deletes the accept rule installed for the route prefix.
+func (m *DefaultManager) removeRoutedSource(prefix netip.Prefix) {
+	m.routedSources.mu.Lock()
+	defer m.routedSources.mu.Unlock()
+
+	rule, ok := m.routedSources.rules[prefix]
+	if !ok {
+		return
+	}
+	delete(m.routedSources.rules, prefix)
+
+	if m.firewall == nil {
+		return
+	}
+	if err := m.firewall.DeleteFilterRule(rule); err != nil {
+		log.Debugf("failed to remove inbound rule for routed prefix %s: %v", prefix, err)
+		return
+	}
+	if err := m.firewall.Flush(); err != nil {
+		log.Debugf("failed to flush firewall after removing routed prefix %s: %v", prefix, err)
+	}
+}
